# Headpress Starter — copy to .env.local and fill in.

# WordPress site running Headpress (no trailing slash). Required.
NEXT_PUBLIC_WP_URL=https://wp.example.com

# Publishable key (hp_pk_…) from Headpress → Settings → API keys. Needed when the store enforces it.
NEXT_PUBLIC_HEADPRESS_PUBLISHABLE_KEY=

# Public origin of this storefront, used by the sitemap index and robots.txt.
# Defaults to config.store.urls.storefront from Headpress.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret key (hp_sk_…). Server only — never prefix it with NEXT_PUBLIC_. Lets the auth routes forward
# the shopper's IP (per-shopper rate limits) and server code call Headpress `server/*` routes.
HEADPRESS_SECRET_KEY=

# Shared secret of the revalidation webhook (Headpress → Storefront → Revalidation).
# Without it /api/revalidate refuses every delivery.
HEADPRESS_WEBHOOK_SECRET=

# Local development only: a WordPress with a self-signed certificate (e.g. https://headpress.local).
# Never set this in production.
# NODE_TLS_REJECT_UNAUTHORIZED=0
