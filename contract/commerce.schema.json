    "properties": {
        "currency": {
            "type": "object",
            "required": [
                "code",
                "symbol",
                "minor_unit",
                "decimal_separator",
                "thousand_separator",
                "prefix",
                "suffix"
            ],
            "additionalProperties": false,
            "properties": {
                "code": {
                    "type": "string"
                },
                "symbol": {
                    "type": "string"
                },
                "minor_unit": {
                    "type": "integer"
                },
                "decimal_separator": {
                    "type": "string"
                },
                "thousand_separator": {
                    "type": "string"
                },
                "prefix": {
                    "type": "string"
                },
                "suffix": {
                    "type": "string"
                }
            }
        },
        "prices_include_tax": {
            "type": "boolean"
        },
        "taxes_enabled": {
            "type": "boolean"
        },
        "tax_display_shop": {
            "type": "string",
            "enum": [
                "incl",
                "excl"
            ]
        },
        "tax_display_cart": {
            "type": "string",
            "enum": [
                "incl",
                "excl"
            ]
        },
        "default_country": {
            "type": "string"
        },
        "selling_countries": {
            "type": "array",
