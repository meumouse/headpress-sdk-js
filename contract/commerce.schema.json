                        "null"
                    ]
                },
                "privacy": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "checkout": {
            "type": "object",
            "required": [
                "coupons",
                "guest_checkout",
                "registration_checkout",
                "registration_my_account"
