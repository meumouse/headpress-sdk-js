{
  "name": "headpress-sdk-js",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint:package": "pnpm -r lint:package",
    "size": "pnpm -r size",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm lint:package && pnpm size",
    "contract:pull": "node scripts/contract-pull.mjs",
    "codegen": "node scripts/codegen.mjs",
    "changeset": "changeset",
    "release": "pnpm check && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.9.3"
  }
}
